# Copy to .env. Keep all credentials out of Git.
PORT=3001
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3001
DATA_DIR=./data

# Demo templates work without a paid API. Set ai to enable the provider.
GENERATION_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Required if HOST exposes the server beyond loopback. Minimum 12 characters.
ADMIN_PASSWORD=
SESSION_SECRET=

# Community messaging token, with messages/photos permissions.
VK_GROUP_ID=157438856
VK_GROUP_TOKEN=
VK_ADMIN_IDS=
VK_BOT_ENABLED=false

# Separate user token with wall/photos permissions for publishing.
VK_PUBLISH_TOKEN=
VK_API_VERSION=5.199
